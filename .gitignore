# Virtual environment
.venv/
venv/

# Python caches / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Tooling caches
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/

# Editor / OS
.vscode/
.idea/
*.swp
Thumbs.db

# App runtime data (lives in %APPDATA%\sniplingo, never in the repo — listed only as a guard)
config.json
*.log

# Claude Code project-local settings (per-machine)
settings.local.json

# Local OCR corpus cases (e.g. game screenshots that can't be redistributed).
# Same image+.txt pairing as tests/data/ocr; picked up by the same corpus tests.
tests/data/ocr/local/*
!tests/data/ocr/local/.gitkeep
